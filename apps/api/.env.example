# Safe local defaults.
API_ENVIRONMENT=development
API_AUTH_MODE=mock
API_MOCK_AUTH_ENABLED=true
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://revenueos:local-development-only@localhost:5432/revenueos

# Clerk verification placeholders. Do not commit real values.
API_CLERK_JWKS_URL=
API_CLERK_ISSUER=
API_CLERK_AUDIENCE=
API_CLERK_JWKS_TIMEOUT_SECONDS=5
API_CLERK_JWT_LEEWAY_SECONDS=30

# Server-authoritative private-beta policy and guardrails.
API_PRIVATE_BETA_DATA_NOTICE_VERSION=1
API_PRIVATE_BETA_DEFAULT_RETENTION_DAYS=90
API_PRIVATE_BETA_MAX_GENERATIONS_PER_DAY=100
API_PRIVATE_BETA_MAX_OPENAI_REQUESTS_PER_DAY=150
API_PRIVATE_BETA_MAX_TRANSCRIPT_CHARACTERS=200000
API_PRIVATE_BETA_FEEDBACK_PER_USER_PER_DAY=20
API_PRIVATE_BETA_RETENTION_BATCH_SIZE=100
API_PRIVATE_BETA_EXPORT_DIRECTORY=/tmp/revenueos-private-beta-exports
API_FEATURE_OPENAI_PROVIDER_ENABLED=false
API_FEATURE_REVENUE_BRAIN_ENABLED=true
API_FEATURE_OPPORTUNITY_WORKSPACE_ENABLED=true
API_FEATURE_DATA_EXPORT_ENABLED=true
API_FEATURE_ORGANISATION_DELETION_ENABLED=false

# Durable AI worker defaults. Mock mode makes no external AI calls.
API_WORKER_POLL_INTERVAL_SECONDS=1
API_WORKER_LEASE_DURATION_SECONDS=60
API_WORKER_HEARTBEAT_INTERVAL_SECONDS=20
API_WORKER_BASE_RETRY_DELAY_SECONDS=5
API_WORKER_MAX_RETRY_DELAY_SECONDS=300
API_WORKER_DEFAULT_MAX_ATTEMPTS=3
AI_PROVIDER=mock
API_AI_PROVIDER_MODEL_IDENTIFIER=mock-infrastructure-v1
API_AI_PROVIDER_TIMEOUT_SECONDS=10
API_AI_PROMPT_KEY=infrastructure_test
API_AI_STRUCTURED_OUTPUT_MAX_ATTEMPTS=3

# Server-only OpenAI placeholders. Required only when AI_PROVIDER=openai.
# Enabling OpenAI sends the selected meeting transcript to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=4096
