# Safe local defaults. Mock authentication is visibly labelled in the UI.
ORYNTELA_ENVIRONMENT=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AUTH_MODE=mock
MOCK_AUTH_ENABLED=true
# Enable only after the production domain and HTTPS are stable. Preload and
# includeSubDomains are deliberately not configured by the application.
ORYNTELA_HSTS_ENABLED=false

# Clerk placeholders. Do not commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional custom Clerk JWT template name. Configure its audience to match
# API_CLERK_AUDIENCE and include Clerk's active organisation claims.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=
