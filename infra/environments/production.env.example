# Oryntela production configuration contract. This is a classification and
# handoff template, not a deployable .env file. Never commit filled values.

# Web — public/build configuration
ORYNTELA_ENVIRONMENT=production
NEXT_PUBLIC_SITE_URL=https://oryntela.com.au
NEXT_PUBLIC_APP_URL=https://oryntela.com.au
NEXT_PUBLIC_API_BASE_URL=https://api.oryntela.com.au
AUTH_MODE=clerk
MOCK_AUTH_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=oryntela-api
ORYNTELA_HSTS_ENABLED=false

# Web — secret/runtime-only configuration
CLERK_SECRET_KEY=

# API — required production configuration
API_ENVIRONMENT=production
API_AUTH_MODE=clerk
API_MOCK_AUTH_ENABLED=false
API_IDENTITY_JIT_PROVISIONING_ENABLED=false
API_LOG_LEVEL=INFO
API_HSTS_ENABLED=false
API_CORS_ORIGINS=https://oryntela.com.au
API_ALLOWED_HOSTS=api.oryntela.com.au
DATABASE_URL=
API_CLERK_JWKS_URL=
API_CLERK_ISSUER=
API_CLERK_AUDIENCE=
API_OUTREACH_SUPPRESSION_HMAC_KEY=

# API — private object storage required by current Create/evidence defaults
API_VISUAL_STORAGE_BACKEND=s3_compatible
API_VISUAL_S3_ENDPOINT=https://syd1.digitaloceanspaces.com
API_VISUAL_S3_BUCKET=
API_VISUAL_S3_REGION=syd1
API_VISUAL_S3_ACCESS_KEY_ID=
API_VISUAL_S3_SECRET_ACCESS_KEY=
API_VISUAL_STORAGE_SIGNING_SECRET=

# Worker — required on the worker component, harmless if present on the API
API_WORKER_HEALTH_PORT=8081
API_WORKER_HEALTH_MAX_STALENESS_SECONDS=180

# Initial synthetic-only deployment posture. Real-data/customer launch remains
# blocked until WO-045 and all legal/backup/export/deletion approvals pass.
API_PRIVATE_BETA_REAL_DATA_ENABLED=false
API_FEATURE_DATA_EXPORT_ENABLED=false
API_FEATURE_ORGANISATION_DELETION_ENABLED=false

# Fail-closed commercial/provider posture. Do not change these values merely to
# make a deployment pass.
API_FEATURE_BILLING_ENABLED=false
API_FEATURE_CREDITS_ENABLED=false
API_BILLING_PROVIDER_NAME=deterministic
API_PROSPECT_RESEARCH_PROVIDER_NAME=mock
API_FEATURE_PROSPECT_EXTERNAL_PROVIDER_ENABLED=false
API_FEATURE_INTEGRATIONS_ENABLED=false
API_FEATURE_ACTION_EXECUTION_ENABLED=false
API_FEATURE_MOCK_CONNECTORS_ENABLED=false
API_FEATURE_MICROSOFT_365_ENABLED=false
API_MICROSOFT_PRODUCTION_ACTIVATION_APPROVED=false
API_FEATURE_GOOGLE_WORKSPACE_ENABLED=false
API_GOOGLE_WORKSPACE_PRODUCTION_ACTIVATION_APPROVED=false
API_FEATURE_HUBSPOT_CRM_ENABLED=false
API_HUBSPOT_PRODUCTION_ACTIVATION_APPROVED=false
API_FEATURE_SALESFORCE_CRM_ENABLED=false
API_SALESFORCE_PRODUCTION_ACTIVATION_APPROVED=false

# Required only when real-data mode is separately approved
API_PRIVATE_BETA_LEGAL_APPROVAL_REFERENCE=
API_PRIVATE_BETA_SUPPORT_EMAIL=
API_PRIVATE_BETA_BACKUP_ENCRYPTION_KEY=
API_PRIVATE_BETA_DEFAULT_RETENTION_DAYS=90
API_PRIVATE_BETA_EXPORT_DIRECTORY=
API_PRIVATE_BETA_EXTERNAL_AI_APPROVED=false

# Required only when one or more production connectors are approved
API_CONNECTOR_CREDENTIAL_MASTER_KEY=
API_MICROSOFT_CLIENT_ID=
API_MICROSOFT_CLIENT_SECRET=
API_MICROSOFT_OAUTH_REDIRECT_URI=https://oryntela.com.au/settings/integrations/microsoft/callback
API_GOOGLE_CLIENT_ID=
API_GOOGLE_CLIENT_SECRET=
API_GOOGLE_OAUTH_REDIRECT_URI=https://oryntela.com.au/settings/integrations/google/callback
API_HUBSPOT_CLIENT_ID=
API_HUBSPOT_CLIENT_SECRET=
API_HUBSPOT_OAUTH_REDIRECT_URI=https://oryntela.com.au/settings/integrations/hubspot/callback
API_SALESFORCE_CLIENT_ID=
API_SALESFORCE_CLIENT_SECRET=
API_SALESFORCE_OAUTH_REDIRECT_URI=https://oryntela.com.au/settings/integrations/salesforce/callback

# Required only after a Prospect provider, licensing, economics and Credits are
# owner-approved. Apollo is not approved by WO-054.
API_APOLLO_API_KEY=
API_PROSPECT_PROVIDER_APPROVED=false
API_PROSPECT_PROVIDER_TERMS_APPROVED=false
API_PROSPECT_PROVIDER_PRIVACY_APPROVED=false
API_PROSPECT_PROVIDER_PRODUCTION_CREDIT_PRICES_APPROVED=false
API_PROSPECT_PROVIDER_HEALTH_REFERENCE=
API_PROSPECT_PROVIDER_COST_MODEL_REFERENCE=
API_PROSPECT_PROVIDER_COST_MICROS_PER_CREDIT=
API_CREDITS_MARGIN_FLOOR_BASIS_POINTS=
API_CREDITS_MARGIN_POLICY_REFERENCE=

# Stripe remains test-only in current code. Live keys and prices are prohibited
# by validation, so they are deliberately absent from this production template.
